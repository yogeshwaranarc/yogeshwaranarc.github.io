---
// Full project card on /projects/: status bar, title, summary, spec grid, bullets, footer.
import type { Project } from '../data/projects';
import Tags from './Tags.astro';
import Bullets from './Bullets.astro';

interface Props {
  project: Project;
  /** 1-based position, shown as "01 · host". */
  no: number;
}
const { project: p, no } = Astro.props;
---

<article style="display:flex; flex-direction:column; border:1px solid var(--line); border-radius:4px; background:var(--panel); overflow:hidden">
  <div style="display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:6px 12px; padding:10px 16px; border-bottom:1px solid var(--line); font-family:'Geist Mono',monospace; font-size:10.5px; color:var(--mut)">
    <div style="display:flex; align-items:center; gap:7px"><div style="width:6px; height:6px; border-radius:50%; background:var(--ac)"></div><div>{String(no).padStart(2, '0')} · {p.host}</div></div>
    <div style="letter-spacing:.08em; color:var(--dim)">{p.status}</div>
  </div>
  <div style="display:flex; flex-direction:column; gap:16px; padding:20px 16px 18px">
    <div style="display:flex; flex-direction:column; gap:8px">
      <h2 style="margin:0; font-size:24px; font-weight:600; letter-spacing:-.02em">{p.title}</h2>
      <p style="margin:0; font-size:16px; line-height:1.6; color:var(--mut); text-wrap:pretty">{p.summary}</p>
    </div>
    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:1px; background:var(--line); border:1px solid var(--line); border-radius:3px; overflow:hidden">{p.specs.map(([k, v]) => <div style="display:flex; flex-direction:column; gap:5px; padding:11px 12px; background:var(--panel)"><div style="font-family:'Geist Mono',monospace; font-size:9.5px; letter-spacing:.08em; color:var(--dim)">{k}</div><div style="font-family:'Geist Mono',monospace; font-size:13px; color:var(--fg)">{v}</div></div>)}</div>
    <Bullets items={p.bullets} />
    <div style="display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:10px 16px; padding-top:14px; border-top:1px solid var(--line)">
      <Tags tags={p.tags} />
      <div style="display:flex; flex-wrap:wrap; gap:6px 16px; font-family:'Geist Mono',monospace; font-size:12px">{p.links.map((l) => <a href={l.url} target="_blank" rel="noopener" style="color:var(--act); text-decoration:none">{l.label}</a>)}</div>
    </div>
  </div>
</article>
