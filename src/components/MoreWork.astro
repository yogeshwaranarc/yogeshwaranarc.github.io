---
// "More work" on the home page: the short cards for projects that carry a `card`.
import { PROJECTS } from '../data/projects';
import Tags from './Tags.astro';
const cards = PROJECTS.filter((p) => p.card);
---

<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,290px),1fr)); gap:14px">
  {cards.map((p) => {
    const c = p.card!;
    return (
      <article style="display:flex; flex-direction:column; border:1px solid var(--line); border-radius:4px; background:var(--panel); overflow:hidden">
        <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; padding:9px 14px; border-bottom:1px solid var(--line); font-family:'Geist Mono',monospace; font-size:10.5px; color:var(--mut)">
          <div style="display:flex; align-items:center; gap:7px"><div style="width:6px; height:6px; border-radius:50%; background:var(--ac)"></div><div>{p.host}</div></div>
          <div style="letter-spacing:.08em; color:var(--dim)">{p.status}</div>
        </div>
        <div style="flex:1; display:flex; flex-direction:column; gap:12px; padding:16px 14px 14px">
          <h3 style="margin:0; font-size:20px; font-weight:600; letter-spacing:-.01em">{c.title}</h3>
          <p style="margin:0; font-size:14.5px; line-height:1.55; color:var(--mut); text-wrap:pretty">{c.text}</p>
          <div style="display:flex; flex-direction:column; gap:5px; padding:10px 0; border-top:1px solid var(--line); border-bottom:1px solid var(--line); font-family:'Geist Mono',monospace; font-size:11px; color:var(--fg)">{c.specs.map(([k, val]) => <div style="display:flex; justify-content:space-between; gap:12px"><div style="color:var(--dim)">{k}</div><div style="text-align:right">{val}</div></div>)}</div>
          <Tags tags={c.tags} rowStyle="margin-top:auto" />
          {c.link && <a href={c.link.url} target="_blank" rel="noopener" style="font-family:'Geist Mono',monospace; font-size:12px; color:var(--act); text-decoration:none">{c.link.label}</a>}
        </div>
      </article>
    );
  })}
</div>
