---
// One rack ear: the mounting flange at each end of a chassis, with oblong screw holes.
// The inner edge carries a dark line plus a faint highlight, so `side` flips the shadow.
interface Props {
  side: 'left' | 'right';
  holes: number;
  /** Vertical padding in px: 14 on the server, 12 on the patch panel. */
  pad: number;
}
const { side, holes, pad } = Astro.props;
const sign = side === 'left' ? '-' : '';
---

<div style={`width:clamp(14px,4vw,30px); flex:none; display:flex; flex-direction:column; justify-content:space-between; align-items:center; padding:${pad}px 0; box-shadow:inset ${sign}1px 0 0 rgba(0,0,0,.5), inset ${sign}2px 0 0 rgba(255,255,255,.06)`}>
  {Array.from({ length: holes }, () => <div style="width:8px;height:12px;border-radius:4px;background:#070908;box-shadow:inset 0 2px 3px #000,0 1px 0 rgba(255,255,255,.2)" />)}
</div>
